rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function autenticado() {
      return request.auth != null;
    }

    function usuarioAtual() {
      return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid));
    }

    function usuarioAtivo() {
      return autenticado()
        && usuarioAtual().data.get('ativo', true) != false;
    }

    function adminOuGestor() {
      return usuarioAtivo()
        && usuarioAtual().data.perfil in ['admin', 'gestor'];
    }

    match /usuarios/{uid}/perfil/avatar {
      allow read: if usuarioAtivo()
        && (request.auth.uid == uid || adminOuGestor());

      allow create, update: if usuarioAtivo()
        && request.auth.uid == uid
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if usuarioAtivo() && request.auth.uid == uid;
    }

    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
